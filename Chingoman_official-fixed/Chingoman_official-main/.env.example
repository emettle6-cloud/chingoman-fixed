# Client-side (Vite) — safe to expose in the browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Everything else (Paystack secret key, Resend API key, Supabase service
# role key) is server-side only and lives in Supabase Edge Function secrets,
# NOT in this file and NOT in anything Vite bundles. See
# SETUP_VERIFICATION_AND_PAYMENTS.md for the full list and how to set them.
